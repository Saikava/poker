{
  "name": "texas-holdem-poker-engine",
  "version": "1.0.0",
  "description": "A comprehensive Texas Hold'em poker engine in JavaScript",
  "main": "src/index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "poker",
    "texas-holdem",
    "game-engine",
    "cards"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "babel-jest": "^30.0.4",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^30.0.4"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js"
    ],
    "projects": [
      {
        "displayName": "node",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/test/**/*.test.js",
          "<rootDir>/src/**/*.test.js"
        ]
      },
      {
        "displayName": "jsdom",
        "testEnvironment": "jsdom",
        "testMatch": [
          "<rootDir>/ui/test/**/*.test.js"
        ],
        "setupFilesAfterEnv": [
          "<rootDir>/ui/test/setup.js"
        ],
        "moduleNameMapper": {
          "^@poker-engine/(.*)$": "<rootDir>/src/$1"
        },
        "transform": {
          "^.+\\.js$": "babel-jest"
        },
        "transformIgnorePatterns": [
          "node_modules/(?!(.*\\.mjs$))"
        ]
      }
    ]
  }
}
